# Copia este archivo a .env.local y completa los valores.

# API key de Anthropic (obligatoria para que Lía funcione).
# Consíguela en https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modelo por defecto de los agentes (opcional). Default: claude-opus-4-8 (máxima calidad).
# Para producción de alto volumen puedes bajar a claude-sonnet-5 o claude-haiku-4-5.
AGENT_MODEL=claude-opus-4-8

# ── Canal WhatsApp (Fase 3) — déjalo vacío hasta conectar Meta ──
# Token que TÚ inventas y pegas igual en Meta al suscribir el webhook:
WHATSAPP_VERIFY_TOKEN=
# App secret de tu app de Meta (valida la firma de los webhooks):
META_APP_SECRET=
# Token de acceso del número (WhatsApp Cloud API):
WHATSAPP_TOKEN=
# Tenant que atiende el número si no hay mapeo (default: leadlab):
WHATSAPP_DEFAULT_TENANT=leadlab

# ── Supabase (persistencia real; sin esto usa store local JSON) ──
# Project Settings → API en supabase.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase Auth (login real con clave + código 2FA al correo) ──
# anon/publishable key (pública por diseño). Si está presente, la consola
# usa login real en vez del candado básico. Requiere SMTP propio para el
# correo del código en producción (el built-in de Supabase es rate-limited).
SUPABASE_ANON_KEY=

# ── Correo (Resend) — código de login + notificaciones ──
# API key de resend.com. Sin esto, el código de login cae al correo
# interno de Supabase (rate-limited). Con leadlab.cl verificado en Resend,
# poné EMAIL_FROM con tu dominio.
RESEND_API_KEY=
EMAIL_FROM=Lead Lab <onboarding@resend.dev>

# ── Candado de la consola online (fallback si no hay Supabase Auth) ──
CONSOLE_PASSWORD=
