# Copia este archivo a .env.local y completa los valores.

# API key de Anthropic (obligatoria para que Lía funcione).
# Consíguela en https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modelo por defecto de los agentes (opcional). Default: claude-opus-4-8 (máxima calidad).
# Para producción de alto volumen puedes bajar a claude-sonnet-5 o claude-haiku-4-5.
AGENT_MODEL=claude-opus-4-8

# ── Canal WhatsApp (Fase 3) — déjalo vacío hasta conectar Meta ──
# Token que TÚ inventas y pegas igual en Meta al suscribir el webhook:
WHATSAPP_VERIFY_TOKEN=
# App secret de tu app de Meta (valida la firma de los webhooks):
META_APP_SECRET=
# Token de acceso del número (WhatsApp Cloud API):
WHATSAPP_TOKEN=
# Tenant que atiende el número si no hay mapeo (default: leadlab):
WHATSAPP_DEFAULT_TENANT=leadlab
